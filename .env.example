# Supabase — Get these from your Supabase project dashboard
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Feature Flags
VITE_VISITS_ATOMIC_EXECUTION=false

# AI Operations — disabled by default.
# Set PREVIEW=true locally to review the UI without applying any database migration.
# Keep DATA_MODE=preview until ai_ops migrations/RPCs are explicitly approved and applied.
VITE_AI_OPERATIONS_PREVIEW=false
VITE_AI_OPERATIONS_DATA_MODE=preview
